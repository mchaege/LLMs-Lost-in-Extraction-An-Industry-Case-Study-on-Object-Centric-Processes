            "attributes": [
                {
                    "name": "proposalstatus",
                    "description": "Status of change proposal"
                }
            ]
        },
        {
            "name": "checkchangeproposal",
            "description": "Check/Review a change proposal",
            "attributes": [
                {
                    "name": "checkstatus",
                    "description": "Check status"
                }
            ]
        },
        {
            "name": "linkdocumenttomasterdata",
            "description": "Link document to master data or other documents",

{
    "objs": [
        {
            "name": "document",
            "description": "Central artifact in P&R management; contains metadata and lifecycle information",
            "attributes": [
                {
                    "name": "abbreviation",
                    "description": "Document abbreviation"
                },
                {
                    "name": "title",
                    "description": "Document title"
                },
                {
                    "name": "version",
                    "description": "Document version number"
                },
                {
                    "name": "status",
                    "description": "Current status of the document"
                },
                {
                    "name": "documenttype",
                    "description": "Type of the document (DocumentType)"
                },
                {
                    "name": "references",
                    "description": "References to Master data or other documents"
                },
                {
                    "name": "itapplications",
                    "description": "Related IT applications"
                },
                {
                    "name": "relevantcompanies",
                    "description": "Relevant companies"
                },
                {
                    "name": "areasofvalidity",
                    "description": "Areas of validity"
                },
                {
                    "name": "releasedate",
                    "description": "Release date of the current version"
                }
            ]
        },
        {
            "name": "documenttype",
            "description": "Defines document types for categorization",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the document type"
                },
                {
                    "name": "abbreviation",
                    "description": "Abbreviation of the document type"
                },
                {
                    "name": "description",
                    "description": "Description of the document type"
                }
            ]
        },
        {
            "name": "documenttemplate",
            "description": "Template used for documents; selectable at creation",
            "attributes": [
                {
                    "name": "name",
                    "description": "Template name"
                }
            ]
        },
        {
            "name": "attachment",
            "description": "Attachment that is released with the main document; has its own release cycle",
            "attributes": [
                {
                    "name": "name",
                    "description": "Attachment name"
                },
                {
                    "name": "content",
                    "description": "Content or reference to the attachment"
                },
                {
                    "name": "releasedate",
                    "description": "Release date of the attachment"
                },
                {
                    "name": "documentversion",
                    "description": "Document version to which the attachment belongs"
                }
            ]
        },
        {
            "name": "additionalinfo",
            "description": "Additional information attached to a document",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the information item"
                },
                {
                    "name": "content",
                    "description": "Content or reference to the information item"
                },
                {
                    "name": "equipmentrelated",
                    "description": "Related equipment if any"
                }
            ]
        },
        {
            "name": "equipment",
            "description": "Equipment attached to a document; has its own versioning",
            "attributes": [
                {
                    "name": "name",
                    "description": "Equipment name"
                },
                {
                    "name": "version",
                    "description": "Equipment version"
                }
            ]
        },
        {
            "name": "usergroup",
            "description": "Group of users used for access control",
            "attributes": [
                {
                    "name": "name",
                    "description": "Group name"
                }
            ]
        },
        {
            "name": "readergroup",
            "description": "Reader group used for access control",
            "attributes": [
                {
                    "name": "name",
                    "description": "Reader group name"
                }
            ]
        },
        {
            "name": "distributionlist",
            "description": "Distribution lists used for workflow and acknowledgement",
            "attributes": [
                {
                    "name": "name",
                    "description": "Distribution list name"
                }
            ]
        },
        {
            "name": "author",
            "description": "Author role for a document; associated user",
            "attributes": [
                {
                    "name": "user",
                    "description": "Author user identifier"
                }
            ]
        },
        {
            "name": "coauthor",
            "description": "Co-author role for a document; associated user",
            "attributes": [
                {
                    "name": "user",
                    "description": "Co-author user identifier"
                }
            ]
        },
        {
            "name": "reviewer",
            "description": "Reviewer role for a document; associated user",
            "attributes": [
                {
                    "name": "user",
                    "description": "Reviewer user identifier"
                }
            ]
        },
        {
            "name": "releaser",
            "description": "Releaser role for a document; associated user",
            "attributes": [
                {
                    "name": "user",
                    "description": "Releaser user identifier"
                }
            ]
        },
        {
            "name": "translator",
            "description": "Translator role for a document; associated user",
            "attributes": [
                {
                    "name": "user",
                    "description": "Translator user identifier"
                }
            ]
        }
    ],

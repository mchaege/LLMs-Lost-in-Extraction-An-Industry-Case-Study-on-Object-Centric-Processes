{
    "objs": [
        {
            "name": "document",
            "description": "Core object representing a P&R document in the system",
            "attributes": [
                {
                    "name": "version",
                    "description": "Current version number"
                },
                {
                    "name": "status",
                    "description": "Current state (e.g., editing, released, archived)"
                },
                {
                    "name": "language",
                    "description": "Document language"
                },
                {
                    "name": "valid_from",
                    "description": "Start of validity period"
                },
                {
                    "name": "valid_until",
                    "description": "End of validity period"
                },
                {
                    "name": "document_type",
                    "description": "Type of document (e.g., Policy, Guideline, Work Instruction)"
                },
                {
                    "name": "template",
                    "description": "Template applied when creating content"
                }
            ]
        },
        {
            "name": "documenttype",
            "description": "Type of document",
            "attributes": [
                {
                    "name": "name",
                    "description": "Document type name"
                },
                {
                    "name": "abbreviation",
                    "description": "Abbreviation for type"
                }
            ]
        },
        {
            "name": "template",
            "description": "Template used for documents",
            "attributes": [
                {
                    "name": "name",
                    "description": "Template name"
                },
                {
                    "name": "path",
                    "description": "Template path or reference"
                }
            ]
        },
        {
            "name": "attachment",
            "description": "Attachment tied to a document",
            "attributes": [
                {
                    "name": "release_cycle",
                    "description": "Release cycle for attachment"
                },
                {
                    "name": "archived",
                    "description": "Archived flag"
                },
                {
                    "name": "associated_document",
                    "description": "Document this attachment belongs to"
                }
            ]
        },
        {
            "name": "additionalinfo",
            "description": "Additional information attached to a document",
            "attributes": [
                {
                    "name": "type",
                    "description": "Type/category"
                },
                {
                    "name": "content",
                    "description": "Information content"
                }
            ]
        },
        {
            "name": "equipment",
            "description": "Equipment attached as part of document",
            "attributes": [
                {
                    "name": "name",
                    "description": "Equipment name"
                },
                {
                    "name": "type",
                    "description": "Equipment type"
                }
            ]
        },
        {
            "name": "changeproposal",
            "description": "Proposal for changes to a document",
            "attributes": [
                {
                    "name": "status",
                    "description": "Proposal status"
                },
                {
                    "name": "author",
                    "description": "Author of change proposal"
                },
                {
                    "name": "created_on",
                    "description": "Creation timestamp"
                }
            ]
        },
        {
            "name": "distributionlist",
            "description": "Distribution list for a document",
            "attributes": [
                {
                    "name": "groups",
                    "description": "List of groups assigned"
                }
            ]
        },
        {
            "name": "usergroup",
            "description": "Group of users",
            "attributes": [
                {
                    "name": "name",
                    "description": "Group name"
                }
            ]
        },
        {
            "name": "user",
            "description": "Individual user",
            "attributes": [
                {
                    "name": "username",
                    "description": "User identifier"
                }
            ]
        },
        {
            "name": "translation",
            "description": "Translation of a document into a language",
            "attributes": [
                {
                    "name": "language",
                    "description": "Target language code"
                }
            ]
        }
    ],

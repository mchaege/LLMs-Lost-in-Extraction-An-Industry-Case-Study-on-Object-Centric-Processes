{
    "objs": [
        {
            "name": "document",
            "description": "Main document in the system, subject to lifecycle processes such as release, review, and versioning.",
            "attributes": [
                {
                    "name": "title",
                    "description": "Document title"
                },
                {
                    "name": "version",
                    "description": "Document version identifier"
                },
                {
                    "name": "language",
                    "description": "Original language of the document"
                },
                {
                    "name": "status",
                    "description": "Current status (e.g., editing, released)"
                }
            ]
        },
        {
            "name": "documenttype",
            "description": "Type of document (e.g., Policy, Guideline, Work Instruction).",
            "attributes": [
                {
                    "name": "name",
                    "description": "Document type name"
                },
                {
                    "name": "abbrev",
                    "description": "Document type abbreviation"
                }
            ]
        },
        {
            "name": "attachment",
            "description": "External or internal file linked to a Document.",
            "attributes": [
                {
                    "name": "name",
                    "description": "Attachment name"
                },
                {
                    "name": "type",
                    "description": "Attachment type"
                }
            ]
        },
        {
            "name": "additionalinfo",
            "description": "Supplementary information attached to a Document.",
            "attributes": [
                {
                    "name": "name",
                    "description": "Additional information name"
                },
                {
                    "name": "type",
                    "description": "Information type"
                }
            ]
        },
        {
            "name": "equipment",
            "description": "Equipment linked to a Document.",
            "attributes": [
                {
                    "name": "name",
                    "description": "Equipment name"
                },
                {
                    "name": "model",
                    "description": "Equipment model"
                }
            ]
        },
        {
            "name": "distributionlist",
            "description": "List of Groups/Users designated to receive distributions for a Document.",
            "attributes": [
                {
                    "name": "name",
                    "description": "Distribution list name"
                },
                {
                    "name": "members",
                    "description": "Members of the distribution list"
                }
            ]
        },
        {
            "name": "usergroup",
            "description": "Group of users/roles used for access control and distribution.",
            "attributes": [
                {
                    "name": "name",
                    "description": "Group name"
                },
                {
                    "name": "type",
                    "description": "Group type/role"
                }
            ]
        },
        {
            "name": "user",
            "description": "Individual user in the system.",
            "attributes": [
                {
                    "name": "userid",
                    "description": "User identifier"
                },
                {
                    "name": "name",
                    "description": "User name"
                }
            ]
        },
        {
            "name": "changeproposal",
            "description": "Proposal to change a Document before applying changes.",
            "attributes": [
                {
                    "name": "proposalid",
                    "description": "Change proposal identifier"
                },
                {
                    "name": "documentid",
                    "description": "Related Document identifier"
                },
                {
                    "name": "status",
                    "description": "Proposal status"
                }
            ]
        }
    ],

            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the author"
                }
            ]
        },
        {
            "name": "reviewer",
            "description": "Document reviewer role",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the reviewer"
                }
            ]
        },
        {
            "name": "releaser",
            "description": "Document releaser role",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the releaser"
                }
            ]
        },
        {
            "name": "translator",
            "description": "Document translator role",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the translator"
                }
            ]
        }

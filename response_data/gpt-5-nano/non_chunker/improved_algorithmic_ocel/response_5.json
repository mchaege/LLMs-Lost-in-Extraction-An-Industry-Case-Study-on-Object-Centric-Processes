            "attributes": [
                {
                    "name": "name",
                    "description": "Equipment name"
                },
                {
                    "name": "related_document",
                    "description": "Document this equipment is attached to"
                },
                {
                    "name": "version",
                    "description": "Version of the equipment"
                }
            ]
        },
        {
            "name": "change_proposal",

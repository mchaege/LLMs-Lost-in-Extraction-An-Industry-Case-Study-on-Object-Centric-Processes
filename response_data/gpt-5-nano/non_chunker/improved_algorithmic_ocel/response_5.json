            "attributes": [
                {
                    "name": "title",
                    "description": "Title of the change proposal"
                },
                {
                    "name": "related_document",
                    "description": "Document the proposal targets"
                },
                {
                    "name": "created_by",
                    "description": "Author of the change proposal"
                },
                {
                    "name": "created_date",
                    "description": "Date of creation"
                }
            ]
        },
        {
            "name": "reader",

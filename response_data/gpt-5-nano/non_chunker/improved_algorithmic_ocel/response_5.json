{
    "objs": [
        {
            "name": "document",
            "description": "A uniquely identifiable document in P&R Management; contains content and metadata; may have version and status; linked to Document Type.",
            "attributes": [
                {
                    "name": "title",
                    "description": "Document title"
                },
                {
                    "name": "version",
                    "description": "Document version"
                },
                {
                    "name": "status",
                    "description": "Release/status of current version"
                },
                {
                    "name": "type",
                    "description": "Document Type"
                },
                {
                    "name": "language",
                    "description": "Language of the document"
                },
                {
                    "name": "valid_from",
                    "description": "Start of validity for this version"
                },
                {
                    "name": "valid_until",
                    "description": "End of validity for this version"
                }
            ]
        },
        {
            "name": "document_type",
            "description": "Category of a document (e.g., Policy, Guidelines, Procedural Instructions, Work Instruction)",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the document type"
                },
                {
                    "name": "abbreviation",
                    "description": "Abbreviation for the type"
                },
                {
                    "name": "description",
                    "description": "Description of the document type"
                }
            ]
        },
        {
            "name": "template",
            "description": "Template used when creating a new Document object",
            "attributes": [
                {
                    "name": "name",
                    "description": "Template name"
                },
                {
                    "name": "applies_to_document_type",
                    "description": "Document Type this template applies to"
                }
            ]
        },
        {
            "name": "information_object",
            "description": "Generic information object that can be attached to a document",
            "attributes": [
                {
                    "name": "name",
                    "description": "Name of the information object"
                },
                {
                    "name": "related_document",
                    "description": "Document this information object is related to"
                }
            ]
        },
        {
            "name": "additional_information",
            "description": "Document attachment that is released directly via switches and does not have its own release cycle",

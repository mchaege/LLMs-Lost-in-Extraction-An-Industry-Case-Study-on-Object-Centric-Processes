{
    "objs": [
        {
            "name": "policy",
            "description": "A document containing company-wide regulations and processes at a strategic level",
            "attributes": [
                {
                    "name": "name",
                    "description": "Document name or title"
                },
                {
                    "name": "status",
                    "description": "Current state of the document (e.g., editing, in review, released, out of force)"
                },
                {
                    "name": "version",
                    "description": "Version number of the document"
                },
                {
                    "name": "valid_until",
                    "description": "Expiration date of document validity"
                },
                {
                    "name": "abbreviation",
                    "description": "Type abbreviation for the document"
                }
            ]
        },
        {
            "name": "guideline",
            "description": "A document defining locally-defined regulations or business process regulations",
            "attributes": [
                {
                    "name": "name",
                    "description": "Document name or title"
                },
                {
                    "name": "status",
                    "description": "Current state of the document"
                },
                {
                    "name": "version",
                    "description": "Version number of the document"
                },
                {
                    "name": "valid_until",
                    "description": "Expiration date of document validity"
                },
                {
                    "name": "abbreviation",
                    "description": "Type abbreviation for the document"
                }
            ]
        },
        {
            "name": "procedural_instruction",
            "description": "A document describing specific procedures, process sequences, and responsible persons",
            "attributes": [
                {
                    "name": "name",
                    "description": "Document name or title"
                },
                {
                    "name": "status",
                    "description": "Current state of the document"
                },
                {
                    "name": "version",
                    "description": "Version number of the document"
                },
                {
                    "name": "valid_until",
                    "description": "Expiration date of document validity"
                },
                {
                    "name": "abbreviation",
                    "description": "Type abbreviation for the document"
                }
            ]
        },
        {
            "name": "work_instruction",
            "description": "A document detailing specific work steps and procedures for sub-processes",
            "attributes": [
                {
                    "name": "name",
                    "description": "Document name or title"
                },
                {
                    "name": "status",
                    "description": "Current state of the document"
                },
                {
                    "name": "version",
                    "description": "Version number of the document"
                },
                {
                    "name": "valid_until",
                    "description": "Expiration date of document validity"
                },
                {
                    "name": "abbreviation",
                    "description": "Type abbreviation for the document"
                }
            ]
        },
        {
            "name": "attachment",
            "description": "A controlled document linked to a main document that is released with the main document",
            "attributes": [
                {
                    "name": "name",
                    "description": "Attachment name or title"
                },
                {
                    "name": "status",
                    "description": "Current state of the attachment"
                },
                {
                    "name": "version",
                    "description": "Version number matching the main document"
                }
            ]
        },
        {
            "name": "additional_info",
            "description": "A document supplement not subject to release cycle of the main document",
            "attributes": [
                {
                    "name": "name",
                    "description": "Additional info name or title"
                },
                {
                    "name": "status",
                    "description": "Published or unpublished state"
                }
            ]
        },
        {
            "name": "change_proposal",
            "description": "A proposal for changes to an existing document without affecting version history",
            "attributes": [
                {
                    "name": "name",
                    "description": "Change proposal description"
                },
                {
                    "name": "status",
                    "description": "Proposed, scheduled, or completed state"
                }
            ]
        },
        {
            "name": "validity_extension_request",
            "description": "A request to extend the validity period of a document",
            "attributes": [
                {
                    "name": "status",
                    "description": "Pending or approved state"
                },
                {
                    "name": "created_date",
                    "description": "Date the request was created"
                }
            ]
        },
        {
            "name": "override_request",
            "description": "A request to invalidate and archive a document",
            "attributes": [
                {
                    "name": "status",
                    "description": "Pending, approved, or completed state"
                },
                {
                    "name": "archive_duration",
                    "description": "Period for which document remains archived"
                }
            ]
        },
        {
            "name": "reactivation_request",
            "description": "A request to revalidate a previously invalidated document",
            "attributes": [
                {
                    "name": "status",
                    "description": "Pending or approved state"
                }
            ]
        },
        {
            "name": "document_approval_workflow",
            "description": "A workflow process for document creation, review, and release with signature",
            "attributes": [
                {
                    "name": "step",
                    "description": "Current workflow step (creator, review, release)"
                },
                {
                    "name": "status",
                    "description": "In progress or completed state"
                }
            ]
        },
        {
            "name": "translation_workflow",
            "description": "A workflow process for translating released documents to other languages",
            "attributes": [
                {
                    "name": "language",
                    "description": "Target language for translation"
                },
                {
                    "name": "status",
                    "description": "In progress or completed state"
                }
            ]
        },
        {
            "name": "user_group",
            "description": "A group of users with assigned roles and permissions",
            "attributes": [
                {
                    "name": "name",
                    "description": "User group name"
                },
                {
                    "name": "role",
                    "description": "Role assigned to the group (reader, author, reviewer, releaser, translator)"
                }
            ]
        },
        {
            "name": "person",
            "description": "An individual user with specific roles and permissions",
            "attributes": [
                {
                    "name": "name",
                    "description": "Person name"
                },
                {
                    "name": "role",
                    "description": "Role assigned to the person"
                }
            ]
        }
    ],
